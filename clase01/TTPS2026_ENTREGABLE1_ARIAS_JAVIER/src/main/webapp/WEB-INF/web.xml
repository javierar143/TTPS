<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>TTPS2026 Entregable 1</display-name>
    
    <welcome-file-list>
        <welcome-file>formulario</welcome-file>
    </welcome-file-list>

    <context-param>
        <param-name>shows</param-name>
        <param-value>LAS PASTILLAS DEL ABUELO|17 de septiembre;DIEGO TORRES|19 de septiembre;BABASONICOS|14 de noviembre;SERU GIRAN|5 de diciembre;LAS PELOTAS|21 de noviembre</param-value>
    </context-param>

    <context-param>
        <param-name>cantidadEntradas</param-name>
        <param-value>1000</param-value>
    </context-param>

    <context-param>
        <param-name>cantidadMeetAndGreet</param-name>
        <param-value>5</param-value>
    </context-param>

    <listener>
        <listener-class>
            com.example.entregable1.listener.ConfiguracionListener
        </listener-class>
    </listener>

</web-app>